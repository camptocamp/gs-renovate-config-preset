{
  packageRules: [
    /** Docker images versioning */
    {
      matchDatasources: ['docker'],
      versioning: 'loose',
      minimumReleaseAge: '1 day',
    },
    /** Don't have Redis versions like 32bit-stretch */
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['redis'],
      allowedVersions: '/^\\d+\\.\\d+\\.\\d+$/',
    },
  ],
}
