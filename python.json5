{
  customManagers: [
    /** Python version in actions/setup-python action */
    {
      customType: 'regex',
      fileMatch: ['^\\.github/workflows/.*\\.yaml$'],
      matchStrings: [' python-version: [\'"](?<currentValue>[0-9\\.]+)[\'"]'],
      datasourceTemplate: 'python-version',
      depNameTemplate: 'python',
    },
  ],
  /**
   * The requirements of the publishing job, a `.in` file compiled by the `uv-lock` pre-commit hook
   * into the fully locked `.txt` file installed with `uv pip install --requirement`.
   */
  pip_requirements: {
    managerFilePatterns: ['**/publish-requirements.in'],
  },
  /** The compiled file is generated by the `uv-lock` hook, Renovate must not touch it */
  ignorePaths: ['**/publish-requirements.txt'],
  packageRules: [
    /** Ungroup Python dependencies */
    {
      matchDepNames: ['python'],
      groupName: 'Python',
    },
    /** In file `.python-version`, use the `<major>.<minor>` version */
    {
      matchFileNames: ['.python-version', '**/.python-version'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)$',
      allowedVersions: '/^[0-9]+\\.[0-9]+$/',
    },
    /** Don't update the Python version in the `pyproject.toml`, `.python-version`, and workflow files */
    {
      matchFileNames: [
        'pyproject.toml',
        '**/pyproject.toml',
        '.python-version',
        '**/.python-version',
        '.github/workflows/*.yaml',
      ],
      matchDepNames: ['python'],
      enabled: false,
    },
  ],
}
